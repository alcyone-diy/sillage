// Secrets.sample.xcconfig
// Duplicate this file, rename it to Secrets.xcconfig, and fill in your actual credentials.
// Secrets.xcconfig is ignored by git so your secrets won't be committed.

// Identifiant OAuth2 (client public, authorization code + PKCE) de l'application sur
// accounts.geogarage.com : sert aux tuiles et à la connexion. Depuis le 11 sept. 2026 c'est la
// seule valeur à recevoir de GeoGarage pour une nouvelle application (voie B).
GEOGARAGE_CLIENT_ID =

// Dedicated API key for CAAS offline package generation (caas.geogarage.com)
GEOGARAGE_CAAS_API_KEY =

// ⚠️ NEVER log, store in UserDefaults, or expose this value anywhere.
GEOGARAGE_SHARED_SECRET =
